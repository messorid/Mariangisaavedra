# Boletín (Newsletter) — alta de suscriptores vía Resend.
# Sin estas dos variables el formulario NO guarda nada y muestra un aviso
# honesto pidiendo escribir por WhatsApp. Ver app/actions/newsletter.ts
#
# 1) Crea la API key en  https://resend.com/api-keys
# 2) Crea la audiencia en https://resend.com/audiences  y copia su ID
#
# En local: copia este archivo a .env.local y rellena los valores.
# En Vercel: Project Settings -> Environment Variables.

RESEND_API_KEY=
RESEND_AUDIENCE_ID=
